# Stage 1: Planet-side military base (DESIGN.md §3 Stages). Gray-box layout.
# Format: see src/stage/stage_def.gd. Times are seconds of stage time.
# A ground object takes 9 s to cross the screen (540 px at 60 px/s).
# Screen: 960 x 540; x=480 is the middle. Ships fly near the bottom.

name = Planet Base
length = 240
scroll_speed = 60

