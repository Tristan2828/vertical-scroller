; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vertical Scroller"
config/version="0.0.6"
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameInput="*res://src/autoload/game_input.gd"
Settings="*res://src/autoload/settings.gd"
Net="*res://src/autoload/net.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=960
window/size/viewport_height=540
; Windowed size. 960x540 is the game's own size (ScreenFit.BASE); Main scales
; it to the window itself, so the window is not stretched.
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="disabled"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom="res://src/ui/theme/game_theme.tres"
theme/default_font_antialiasing=0
theme/default_font_hinting=2
theme/default_font_subpixel_positioning=0

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
